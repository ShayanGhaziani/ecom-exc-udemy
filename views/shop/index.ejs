  <%- include('../includes/head.ejs') %>
  <link rel="stylesheet" href="/css/product.css">
  </head>

  <body>
    <%- include('../includes/navigation.ejs') %>

    <main>
      <% if (prods.rows.length> 0) { %>
      <div class="grid">
        <% for (let product of prods.rows) { %>
        <article class="card product-item">
          <header class="card__header">
            <h1 class="product__title">
              <%= product.dataValues.title %>
            </h1>
          </header>
          <div class="card__image">
            <img src="<%= (product.imageUrl.match(/^(http|https):\/\//)) ? product.imageUrl : '/' + product.imageUrl %>" alt="<%= product.dataValues.title %>">
          </div>
          <div class="card__content">
            <h2 class="product__price">$<%= product.dataValues.price %>
            </h2>
            <p class="product__description">
              <%= product.dataValues.description %>
            </p>
          </div>
          <div class="card__actions">
            <a href="/products/<%= product.dataValues.id %>" class="btn">Details</a>
            <%- include('../includes/add-to-cart.ejs', {product: product}) %>
          </div>
        </article>
        <% } %>
      </div>
      <% } else { %>
      <h1>No Products Found!</h1>
      <% } %>
      <%- include('../includes/pagination.ejs') %>
    </main>
    <%- include('../includes/end.ejs') %>