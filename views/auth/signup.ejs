<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/auth.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>

            <main>
                <% if(errorMessage){ %>
                    <div>
                        <%= errorMessage %>
                    </div>
                    <% } %>
                        <% if(!isAuthenticated) { %>
                            <form class="login-form" action="/signup" method="POST">
                                <div class="form-control">
                                    <label for="email">E-mail</label>
                                    <input type="email" name="email" id="email" value="<%= oldInput.email ? oldInput.email : '' %>"
                                        class="<%= validationErrors.find(err => err.path === 'email') ? 'invalid' : '' %>"
                                        required>
                                </div>

                                <div class="form-control">
                                    <label for="password">Password</label>
                                    <div class="password-wrapper">
                                        <input type="password" name="password" id="password"
                                            value="<%= oldInput.password ? oldInput.password : '' %>"
                                            class="<%= validationErrors.find(err => err.path === 'password') ? 'invalid' : '' %>"
                                            required>
                                        <button type="button" class="toggle-btn">Show</button>
                                    </div>
                                </div>

                                <div class="form-control">
                                    <label for="confirmedPassword">Confirm Password</label>
                                    <div class="password-wrapper">
                                        <input type="password" name="confirmedPassword" id="confirmedPassword"
                                            value="<%= oldInput.confirmedPassword ? oldInput.confirmedPassword : '' %>"
                                            class="<%= validationErrors.find(err => err.path === 'confirmedPassword') ? 'invalid' : '' %>"
                                            required>
                                        <button type="button" class="toggle-btn">Show</button>
                                    </div>
                                </div>

                                <button class="btn" type="submit">Signup</button>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            </form>

                            <!-- <% } else if(isAuthenticated){ %>
            <form action="/logout" method="post">
                <button class="btn" type="submit">Logout</button>
            </form>
            <% } %> -->
            </main>
            <%- include('../includes/end.ejs') %>